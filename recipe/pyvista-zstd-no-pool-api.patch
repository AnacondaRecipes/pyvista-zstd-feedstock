diff --git a/src/pyvista_zstd/_pool_compat.py b/src/pyvista_zstd/_pool_compat.py
new file mode 100644
index 0000000..cee169d
--- /dev/null
+++ b/src/pyvista_zstd/_pool_compat.py
@@ -0,0 +1,82 @@
+"""Compatibility helpers for zstandard's multi-threaded pool API.
+
+``multi_compress_to_buffer`` / ``multi_decompress_to_buffer`` are only compiled
+into python-zstandard when it is built with its bundled zstd. Conda builds that
+link the system ``libzstd`` expose the buffer types but not those methods, so
+provide equivalent helpers that keep the exact same on-disk format.
+"""
+from __future__ import annotations
+
+import os
+import struct
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+import zstandard as zstd
+
+HAS_POOL_API = "multi_compress_to_buffer" in getattr(zstd, "backend_features", set())
+
+_local = threading.local()
+
+
+def _cctx(level):
+    """Return a per-thread compressor; ZstdCompressor is not thread-safe."""
+    cached = getattr(_local, "cctx", None)
+    if cached is None or cached[0] != level:
+        cached = (level, zstd.ZstdCompressor(level=level))
+        _local.cctx = cached
+    return cached[1]
+
+
+def _dctx():
+    """Return a per-thread decompressor."""
+    cached = getattr(_local, "dctx", None)
+    if cached is None:
+        cached = zstd.ZstdDecompressor()
+        _local.dctx = cached
+    return cached
+
+
+def _workers(threads):
+    """Map zstandard's thread semantics (-1 = all cores, 0 = serial)."""
+    if threads is None or threads == 0:
+        return 0
+    return os.cpu_count() if threads == -1 else threads
+
+
+def compress_many(payloads, *, level=None, threads=0):
+    """Compress each payload into its own zstd frame."""
+    if HAS_POOL_API:
+        return zstd.ZstdCompressor(level=level).multi_compress_to_buffer(
+            payloads, threads=threads
+        )
+    n_workers = _workers(threads)
+    if n_workers and n_workers > 1 and len(payloads) > 1:
+        with ThreadPoolExecutor(max_workers=n_workers) as pool:
+            return [
+                memoryview(buf)
+                for buf in pool.map(lambda payload: _cctx(level).compress(payload), payloads)
+            ]
+    cctx = zstd.ZstdCompressor(level=level)
+    return [memoryview(cctx.compress(payload)) for payload in payloads]
+
+
+def decompress_many(blobs, *, decompressed_sizes, threads=0):
+    """Decompress frames, honouring the packed little-endian uint64 sizes."""
+    if HAS_POOL_API:
+        return zstd.ZstdDecompressor().multi_decompress_to_buffer(
+            blobs, decompressed_sizes=decompressed_sizes, threads=threads
+        )
+    sizes = struct.unpack(f"<{len(decompressed_sizes) // 8}Q", decompressed_sizes)
+    pairs = list(zip(blobs, sizes))
+    n_workers = _workers(threads)
+    if n_workers and n_workers > 1 and len(pairs) > 1:
+        with ThreadPoolExecutor(max_workers=n_workers) as pool:
+            out = pool.map(
+                lambda pair: _dctx().decompress(pair[0], max_output_size=pair[1]), pairs
+            )
+            return [memoryview(buf) for buf in out]
+    dctx = zstd.ZstdDecompressor()
+    return [
+        memoryview(dctx.decompress(blob, max_output_size=size)) for blob, size in pairs
+    ]
